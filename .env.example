# FinAI Backend Environment Variables Example
# Copy this file to .env and update with your actual values

# ===================================================================
# SPRING CONFIGURATION
# ===================================================================
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# Development
DATABASE_URL=jdbc:mysql://localhost:3306/finai_dev?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# Production
# DATABASE_URL=jdbc:mysql://production-host:3306/finai_prod?useSSL=true&serverTimezone=UTC
# DATABASE_USERNAME=finai_user
# DATABASE_PASSWORD=your_secure_password

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ===================================================================
# SECURITY CONFIGURATION
# ===================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===================================================================
# JWT CONFIGURATION (Future use)
# ===================================================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# ===================================================================
# EMAIL CONFIGURATION (Future use)
# ===================================================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# ===================================================================
# CLOUD STORAGE (Future use)
# ===================================================================
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=finai-uploads
